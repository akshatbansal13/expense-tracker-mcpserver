{
  "manifest_version": "0.4",
  "name": "expense-tracker",
  "display_name": "Expense Tracker",
  "version": "0.1.0",
  "description": "An MCP server for managing expenses, credits, categories, and financial summaries.",
  "author": {
    "name": "Akshat Bansal",
    "email": "akshat13bansal@gmail.com"
  },
  "server": {
    "type": "uv",
    "entry_point": "src/expense_tracker_mcpserver/server.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "src/expense_tracker_mcpserver/server.py"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      "win32",
      "darwin",
      "linux"
    ]
  }
}